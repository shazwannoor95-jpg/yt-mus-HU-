<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="my.ytmhu" android:versionCode="2" android:versionName="0.1.1">
    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:label="YTM Head Unit" android:theme="@style/AppTheme"
        android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".PlaybackService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
